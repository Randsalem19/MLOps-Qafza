# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# Postgres (matches Task-01/Task-02)
POSTGRES_DB=olist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=olist_password
POSTGRES_PORT=5432

# Overrides config.yaml's model.mlflow.tracking_uri. Point this at the
# `mlflow` service from docker-compose.yml, or at a real MLflow server URL
# in production. Leave unset for local dev (falls back to sqlite:///mlflow.db).
MLFLOW_TRACKING_URI=http://mlflow:5000
